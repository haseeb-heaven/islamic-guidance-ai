# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment Type (for testing serverless behavior locally)
VERCEL_ENV=development

# Gemini AI Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
API_KEY=your_api_key_here

# Pinecone Vector Database Configuration
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY=YOUR_PINECONE_API_KEY

# Application Settings
THEME=light
GEMINI_MODEL=gemini-pro

# Server Configuration
PORT=8000
HOST=0.0.0.0

# =============================================================================
# CACHE CONFIGURATION (Redis/Vercel KV)
# =============================================================================

# Option 1: Use Vercel KV (Redis) - Recommended for Production
# Get these from: https://vercel.com/dashboard/stores
# KV_REST_API_URL=https://your-kv-rest-api-url.upstash.io
# KV_REST_API_TOKEN=your-kv-rest-api-token
# KV_REST_API_READ_ONLY_TOKEN=your-read-only-token

# Option 2: Use Local Redis (for development testing)
# Uncomment if you have Redis running locally
# REDIS_URL=redis://localhost:6379

# Option 3: In-Memory Cache (Default - No setup needed)
# If no Redis URL is set, the app uses in-memory cache
# ⚠️ Note: In-memory cache doesn't persist across serverless invocations

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Logging Level
LOG_LEVEL=INFO

# Rate Limiting (requests per hour)
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=3600
